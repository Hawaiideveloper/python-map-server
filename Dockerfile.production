# Multi-stage Dockerfile for Python MCP Server - Production Only
FROM python:3.12-slim as production

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    procps \
    git \
    curl \
    redis-tools \
    gcc \
    g++ \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Create user
RUN groupadd -r mcpuser && useradd -r -g mcpuser -u 1000 mcpuser

# Install Poetry
RUN pip install poetry==1.7.1

# Set up application
WORKDIR /app

# Copy dependency files
COPY --chown=mcpuser:mcpuser pyproject.toml poetry.lock ./

# Configure Poetry and install dependencies
RUN poetry config virtualenvs.create false && \
    poetry install --only=main

# Copy application code
COPY --chown=mcpuser:mcpuser . .

# Create necessary directories
RUN mkdir -p /app/logs /app/data /app/temp /app/cache \
    && chown -R mcpuser:mcpuser /app \
    && chmod -R 755 /app

# Create docs directory and copy documentation
RUN mkdir -p /app/docs/python_manuals \
    && chown -R mcpuser:mcpuser /app/docs \
    && chmod -R 755 /app/docs

# Install the application
RUN python -m pip install --no-deps -e .

# Switch to non-root user
USER mcpuser

# Set production environment
ENV ENVIRONMENT=production \
    HTTP_HOST=0.0.0.0 \
    HTTP_PORT=33221 \
    PYTHONPATH=/app/src \
    LOG_LEVEL=info

# Expose port
EXPOSE 33221

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:33221/health || exit 1

# Run the application
CMD ["python", "-m", "mcp_server.server"]