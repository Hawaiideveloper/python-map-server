[tool.poetry]
name = "python-mcp-server"
version = "0.1.0"
description = "A Python MCP server with Python execution, linting, testing, docs, and cloud SDK integrations"
authors = ["AI MCP Server Generator <aicp@example.com>"]
packages = [{include = "mcp_server"}]

[tool.poetry.dependencies]
python = "^3.12"
mcp = "^1.0.0"
ruff = "^0.0.280"
black = "^23.3.0"
pytest = "^7.4.0"
bandit = "^1.7.5"
boto3 = "^1.26.0"
google-cloud-storage = "^2.7.0"
azure-storage-blob = "^12.15.0"
fastapi = "^0.95.0"
uvicorn = "^0.22.0"
# Enhanced security and monitoring
psutil = "^5.9.0"
cryptography = "^41.0.0"
# Database support
sqlalchemy = "^2.0.0"
alembic = "^1.11.0"
# Documentation
sphinx = "^7.1.0"
mkdocs = "^1.5.0"
mkdocs-material = "^9.1.0"
# Data Science & Analysis
numpy = "^1.24.0"
pandas = "^2.0.0"
matplotlib = "^3.7.0"
seaborn = "^0.12.0"
scipy = "^1.10.0"
plotly = "^5.14.0"
# Machine Learning
scikit-learn = "^1.3.0"
# Web & API
requests = "^2.31.0"
httpx = "^0.24.0"
beautifulsoup4 = "^4.12.0"
# Image & Media
Pillow = "^10.0.0"
# Utilities
python-dateutil = "^2.8.0"
pytz = "^2023.3"
pyyaml = "^6.0"
toml = "^0.10.0"
click = "^8.1.0"
rich = "^13.0.0"
# LLM & AI Libraries
openai = "^1.0.0"
anthropic = "^0.28.0"
langchain = "^0.2.0"
langchain-community = "^0.2.0"
langchain-openai = "^0.1.0"
langchain-anthropic = "^0.1.0"
llama-index = "^0.9.0"
transformers = "^4.35.0"
tokenizers = "^0.15.0"
sentence-transformers = "^2.2.0"
chromadb = "^0.4.0"
faiss-cpu = "^1.7.0"
pinecone-client = "^2.2.0"
# Advanced ML/AI
torch = "^2.1.0"
torchvision = "^0.16.0"
tensorflow = "^2.15.0"
keras = "^2.15.0"
xgboost = "^2.0.0"
lightgbm = "^4.1.0"
# NLP & Text Processing
spacy = "^3.7.0"
nltk = "^3.8.0"
textblob = "^0.17.0"
gensim = "^4.3.0"
# Computer Vision
opencv-python = "^4.8.0"
mediapipe = "^0.10.0"
# Audio Processing
librosa = "^0.10.0"
pydub = "^0.25.0"
# Vector Databases & Search
weaviate-client = "^3.25.0"
qdrant-client = "^1.6.0"
# MLOps & Experiment Tracking
mlflow = "^2.8.0"
wandb = "^0.16.0"
# Advanced Data Processing
polars = "^0.20.0"
dask = "^2023.12.0"
# API Development
fastapi-users = "^12.1.0"
sqlmodel = "^0.0.14"
# Async & Concurrency
asyncio-mqtt = "^0.13.0"
aiohttp = "^3.9.0"
# Time Series
prophet = "^1.1.0"
statsmodels = "^0.14.0"
# Graph & Network Analysis
networkx = "^3.2.0"
# Financial Data
yfinance = "^0.2.0"
alpha-vantage = "^2.3.0"
# Geographic Data
geopandas = "^0.14.0"
folium = "^0.15.0"
# Web Scraping Advanced
selenium = "^4.15.0"
scrapy = "^2.11.0"
# Database Connectors
psycopg2-binary = "^2.9.0"
pymongo = "^4.6.0"
redis = "^5.0.0"
# Jupyter & Notebooks
jupyter = "^1.0.0"
ipykernel = "^6.27.0"
jupyterlab = "^4.0.0"
# Code Quality & Analysis
safety = "^2.3.0"
mypy = "^1.7.0"
# Optional heavy libraries (commented out by default)
# tensorflow = "^2.13.0"
# torch = "^2.0.0"
# opencv-python = "^4.8.0"

[tool.poetry.group.dev.dependencies]
pytest-asyncio = "^0.21.0"
pytest-cov = "^4.1.0"
httpx = "^0.24.0"
# Optional production databases (commented out)
# psycopg2-binary = "^2.9.0"  # PostgreSQL
# pymysql = "^1.1.0"  # MySQL

[tool.poetry.scripts]
mcp-server = "mcp_server.server:main"

[build-system]
requires = ["poetry-core"]
build-backend = "poetry.core.masonry.api"

# Tool configurations
[tool.ruff]
line-length = 88
target-version = "py312"
select = ["E", "F", "W", "I", "N", "UP", "S", "B", "A", "COM", "C4", "DTZ", "EM", "EXE", "ISC", "ICN", "G", "PIE", "PYI", "PT", "Q", "RSE", "RET", "SLF", "SIM", "TID", "ARG", "PTH", "PD", "PGH", "PL", "TRY", "NPY", "RUF"]
ignore = ["S101", "S603", "S607"]  # Allow assert, subprocess usage

[tool.ruff.per-file-ignores]
"tests/*" = ["S101", "PLR2004"]  # Allow asserts and magic values in tests

[tool.black]
line-length = 88
target-version = ['py312']
include = '\.pyi?$'
extend-exclude = '''
/(
  # directories
  \.eggs
  | \.git
  | \.hg
  | \.mypy_cache
  | \.tox
  | \.venv
  | build
  | dist
)/
'''

[tool.pytest.ini_options]
minversion = "7.0"
addopts = "-ra -q --strict-markers --strict-config"
testpaths = ["tests"]
python_files = ["test_*.py", "*_test.py"]
python_classes = ["Test*"]
python_functions = ["test_*"]
markers = [
    "slow: marks tests as slow (deselect with '-m \"not slow\"')",
    "integration: marks tests as integration tests",
    "security: marks tests as security-related"
]

[tool.coverage.run]
source = ["src"]
omit = ["*/tests/*", "*/test_*"]

[tool.coverage.report]
exclude_lines = [
    "pragma: no cover",
    "def __repr__",
    "if self.debug:",
    "if settings.DEBUG",
    "raise AssertionError",
    "raise NotImplementedError",
    "if 0:",
    "if __name__ == .__main__.:"
]

[tool.mypy]
python_version = "3.12"
warn_return_any = true
warn_unused_configs = true
disallow_untyped_defs = true
disallow_incomplete_defs = true
check_untyped_defs = true
disallow_untyped_decorators = true
no_implicit_optional = true
warn_redundant_casts = true
warn_unused_ignores = true
warn_no_return = true
warn_unreachable = true
strict_equality = true

[[tool.mypy.overrides]]
module = "tests.*"
disallow_untyped_defs = false
