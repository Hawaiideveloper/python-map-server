
# Python MCP Server Environment Configuration

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Pinecone Vector Database
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment_here

# Weights & Biases (for ML experiment tracking)
WANDB_API_KEY=your_wandb_api_key_here

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5000

# AWS Credentials (for SDK integration)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# Google Cloud Platform
GCP_PROJECT=your_gcp_project_id
GCP_CREDENTIALS_PATH=/path/to/gcp/credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp/credentials.json

# Azure Credentials
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string

# Database Configuration
DATABASE_URL=sqlite:///./mcp_server.db
# DATABASE_URL=postgresql://user:password@localhost/dbname
# DATABASE_URL=mysql://user:password@localhost/dbname

# Authentication & Security
JWT_SECRET_KEY=your_super_secret_jwt_key_here
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=3600

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/mcp_server.log

# Server Configuration
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
MCP_DEBUG=false

# Vector Database Configurations
CHROMA_PERSIST_DIRECTORY=./chroma_db
QDRANT_URL=http://localhost:6333
WEAVIATE_URL=http://localhost:8080

# Jupyter Configuration
JUPYTER_PORT=8888
JUPYTER_TOKEN=your_jupyter_token_here

# Development Settings
DEVELOPMENT_MODE=true
AUTO_RELOAD=true
