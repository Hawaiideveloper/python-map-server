{
  "mcpServers": {
    "python-mcp-server": {
      "command": "python",
      "args": ["-m", "mcp_server.server"],
      "env": {
        "ENVIRONMENT": "production",
        "HTTP_HOST": "0.0.0.0",
        "HTTP_PORT": "33221",
        "PYTHONPATH": "/app/src",
        "LOG_LEVEL": "info"
      }
    }
  }
}
